<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ draws its own splash window before the JS bundle is ready.

      Without these two attributes the system shows the launcher icon on a
      white-by-default window, which is the flash-then-repaint where the
      "cheap app" feeling comes from. Styling it with the same background
      colour and the same mark as the JS splash makes launch continuous:
      native window -> JS splash -> app, with no colour change in between.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

</resources>
